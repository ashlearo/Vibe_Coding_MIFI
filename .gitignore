# ===== Whitelist-подход: пушим только скрипты, HTML и md =====

# Игнорируем всё по умолчанию
*

# Разрешаем спуск по подкаталогам (DZ_1, DZ_2, src и т.д.)
!*/

# Разрешаем только скрипты, HTML и markdown
!*.js
!*.css
!*.html
!*.md
!*.sh

# Разрешаем сами файлы .gitignore
!.gitignore

# ===== Чёткие запреты (приоритет: идут после whitelist) =====

# Изображения не пушим
*.png
*.jpg
*.jpeg
*.gif

# Системные файлы
.DS_Store
Thumbs.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Секреты и ключи
.env
.env.local
id_ed25519*
*.pem
.gitignore

# ===== Исключения: эти файлы НЕ пушим =====
/промпт.md
/промпт_решения_ДЗ.md

# Файлы с описанием заданий («ДЗ N. ...») не пушим — актуально и для будущих заданий
ДЗ*.md

# Локальная папка с тестовыми скриптами
/.tests/
